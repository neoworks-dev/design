{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"id": {
			"type": "string",
			"maxLength": 64,
			"pattern": "^[a-z][a-z0-9-]*$"
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"maxLength": 100
		},
		"version": {
			"type": "string",
			"pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$"
		},
		"description": {
			"type": "string",
			"maxLength": 1000
		},
		"api": {
			"type": "string",
			"pattern": "^\\d+\\.\\d+$"
		},
		"main": {
			"type": "string",
			"minLength": 1
		},
		"ui": {
			"anyOf": [
				{
					"type": "string",
					"minLength": 1
				},
				{
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "string",
						"minLength": 1
					}
				}
			]
		},
		"permissions": {
			"default": [],
			"type": "array",
			"items": {
				"type": "string",
				"enum": [
					"document:read",
					"document:write",
					"selection",
					"network",
					"fs",
					"clipboard",
					"ai",
					"ui:panel",
					"ui:tool",
					"storage"
				]
			}
		},
		"networkAccess": {
			"type": "object",
			"properties": {
				"allowedDomains": {
					"default": [],
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"reasoning": {
					"type": "string"
				}
			},
			"required": [
				"allowedDomains"
			],
			"additionalProperties": false
		},
		"contributes": {
			"default": {
				"commands": [],
				"menus": [],
				"keybindings": [],
				"tools": [],
				"panels": [],
				"inspectors": [],
				"aiTools": [],
				"codegen": []
			},
			"type": "object",
			"properties": {
				"commands": {
					"default": [],
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1
							},
							"title": {
								"type": "string",
								"minLength": 1
							},
							"when": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [
							"id",
							"title"
						],
						"additionalProperties": false
					}
				},
				"menus": {
					"default": [],
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"menu": {
								"type": "string",
								"minLength": 1
							},
							"id": {
								"type": "string",
								"minLength": 1
							},
							"command": {
								"type": "string",
								"minLength": 1
							},
							"title": {
								"type": "string",
								"minLength": 1
							},
							"group": {
								"type": "string"
							},
							"order": {
								"type": "number"
							},
							"when": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [
							"menu",
							"id",
							"command"
						],
						"additionalProperties": false
					}
				},
				"keybindings": {
					"default": [],
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"key": {
								"type": "string",
								"minLength": 1
							},
							"command": {
								"type": "string",
								"minLength": 1
							},
							"when": {
								"type": "string",
								"minLength": 1
							},
							"scope": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [
							"key",
							"command"
						],
						"additionalProperties": false
					}
				},
				"tools": {
					"default": [],
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1
							},
							"title": {
								"type": "string",
								"minLength": 1
							},
							"shortcut": {
								"type": "string",
								"minLength": 1
							},
							"cursor": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [
							"id",
							"title"
						],
						"additionalProperties": false
					}
				},
				"panels": {
					"default": [],
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1
							},
							"title": {
								"type": "string",
								"minLength": 1
							},
							"side": {
								"default": "right",
								"type": "string",
								"enum": [
									"left",
									"right"
								]
							},
							"shortcut": {
								"type": "string",
								"minLength": 1
							},
							"order": {
								"type": "number"
							},
							"when": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [
							"id",
							"title",
							"side"
						],
						"additionalProperties": false
					}
				},
				"inspectors": {
					"default": [],
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1
							},
							"title": {
								"type": "string",
								"minLength": 1
							},
							"tab": {
								"default": "design",
								"type": "string",
								"minLength": 1
							},
							"nodeTypes": {
								"minItems": 1,
								"type": "array",
								"items": {
									"type": "string",
									"minLength": 1
								}
							},
							"order": {
								"type": "number"
							}
						},
						"required": [
							"id",
							"title",
							"tab"
						],
						"additionalProperties": false
					}
				},
				"aiTools": {
					"default": [],
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1
							},
							"description": {
								"type": "string",
								"minLength": 1,
								"maxLength": 4000
							},
							"inputSchema": {
								"default": {
									"type": "object",
									"properties": {}
								},
								"type": "object",
								"propertyNames": {
									"type": "string"
								},
								"additionalProperties": {}
							},
							"write": {
								"default": false,
								"type": "boolean"
							}
						},
						"required": [
							"id",
							"description",
							"inputSchema",
							"write"
						],
						"additionalProperties": false
					}
				},
				"codegen": {
					"default": [],
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1
							},
							"label": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [
							"id",
							"label"
						],
						"additionalProperties": false
					}
				}
			},
			"required": [
				"commands",
				"menus",
				"keybindings",
				"tools",
				"panels",
				"inspectors",
				"aiTools",
				"codegen"
			],
			"additionalProperties": false
		},
		"editorType": {
			"default": [
				"design"
			],
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "string",
				"enum": [
					"design",
					"dev"
				]
			}
		},
		"build": {
			"type": "string",
			"minLength": 1
		}
	},
	"required": [
		"id",
		"name",
		"version",
		"api",
		"main",
		"permissions",
		"contributes",
		"editorType"
	],
	"additionalProperties": false
}
