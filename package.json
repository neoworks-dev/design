{
	"name": "penpot-figma-clone",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "electron/dist/main.js",
	"description": "Offline design tool with AI integration and plugin extensibility.",
	"author": {
		"name": "Moritz Utcke"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun run electron:compile",
		"preview": "vite preview",
		"electron:compile": "bun build electron/main.ts --outdir electron/dist --target node --format esm --packages external --sourcemap=linked && bun build electron/preload.ts --outfile electron/dist/preload.cjs --target node --format cjs --packages external",
		"electron:dev": "bun run electron:compile && DEV_SERVER_URL=http://localhost:5173 electron .",
		"electron:build": "bun run build && electron-builder",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
		"lint": "prettier --check . && (oxlint --type-aware; a=$?; eslint .; b=$?; exit $((a | b)))",
		"format": "prettier --write .",
		"lint:fix": "oxlint --type-aware --fix; eslint . --fix",
		"qa": "bun scripts/qa.ts",
		"proof": "bun scripts/proof.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"build": {
		"appId": "dev.neoworks.design",
		"productName": "Neoworks Design",
		"files": [
			"build/**/*",
			"electron/dist/**/*"
		],
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"category": "Graphics"
		}
	},
	"devDependencies": {
		"@neoworks/lint-config": "link:@neoworks/lint-config",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"electron": "^44.5.1",
		"electron-builder": "^26.15.3",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.0",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@fontsource/geist-mono": "^5.3.0",
		"@fontsource/geist-sans": "^5.3.0",
		"@neoworks-dev/ui": "link:@neoworks-dev/ui",
		"@neoworks/extension-system": "link:@neoworks/extension-system",
		"@neoworks/harness": "link:@neoworks/harness",
		"canvaskit-wasm": "^0.42.0",
		"phosphor-svelte": "^3.1.0"
	}
}
